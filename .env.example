# ── Soon ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to run in demo mode (sample data, no Google).

# The two people. The first one is "the maker" (named on the welcome screen).
# id: short slug · name: shown in the app · home: their city
# email: the Google account they sign in with. Leave it out for someone who'll join
# through an invite link (Settings → Make an invite link) and pick their own account.
SOON_PEOPLE='[{"id":"tachi","name":"Tachi","email":"you@example.com","home":"San Antonio"},{"id":"annie","name":"Annie","home":"Austin"}]'
SOON_TIMEZONE=America/Chicago
# One-way drive between your homes, in minutes
SOON_DRIVE_MINUTES=105
# The handwritten line on the welcome screen
SOON_NOTE="for all our weekends ahead — T"

# Public URL of the app (no trailing slash). Used for the Google redirect.
# On Vercel you can leave this out: it uses the project's production domain.
SOON_URL=http://localhost:3000

# Postgres (Neon via the Vercel Marketplace sets this for you; POSTGRES_URL also works)
DATABASE_URL=

# Google OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secrets — generate with: npm run keys
SESSION_SECRET=
TOKEN_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
